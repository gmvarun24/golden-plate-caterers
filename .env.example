# ─────────────────────────────────────────────────────────────────────────────
# Golden Plate Caterers — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# Variables marked (Phase N) are not used yet; they are listed so nothing is a surprise later.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Postgres connection string. Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/golden_plate
# Long random string used by Payload to sign auth tokens. Generate: `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public base URL of the site, no trailing slash. Used for canonical URLs, quote links, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Local Postgres (docker-compose only) ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=golden_plate
POSTGRES_PORT=5432

# ── Design system route ──────────────────────────────────────────────────────
# `/design-system` is always available in development. In production it needs an admin login,
# unless this is set to "true".
DESIGN_SYSTEM_PUBLIC=false

# ── Media storage ────────────────────────────────────────────────────────────
# local (files in ./media) | vercel-blob (Vercel Blob) | s3 (any S3-compatible store: AWS S3, Cloudflare R2, MinIO, Spaces …)
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=vercel-blob. Vercel adds it automatically when you connect a Blob store
# to the project; for local testing copy it from the store's settings.
BLOB_READ_WRITE_TOKEN=
# Required when STORAGE_DRIVER=s3. S3_ENDPOINT is needed for non-AWS providers (e.g. R2).
# S3_PUBLIC_URL: optional public/CDN base URL for files (e.g. https://media.example.com).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Email ────────────────────────────────────────────────────────────────────
# resend | smtp | console (console just logs emails — handy in dev)
EMAIL_PROVIDER=console
EMAIL_FROM="Golden Plate Caterers <hello@example.com>"
# Where new-enquiry notifications go (defaults to the brand email from Brand Settings)
ADMIN_NOTIFY_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── Admin WhatsApp notification (optional) ───────────────────────────────────
# When enabled, POSTs {"to": WHATSAPP_ADMIN_NUMBER, "text": "…"} with a Bearer token to your provider/webhook.
WHATSAPP_NOTIFY_ENABLED=false
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_ADMIN_NUMBER=

# ── Security ─────────────────────────────────────────────────────────────────
# Salt for hashing IPs used in rate limiting (raw IPs are never stored). `openssl rand -hex 16`
RATE_LIMIT_SALT=

# ── Testing ──────────────────────────────────────────────────────────────────
# Integration tests use this database (dropped and recreated on every run; name must contain "test").
# Defaults to DATABASE_URL with the database name replaced by golden_plate_test.
TEST_DATABASE_URL=

# ── Analytics (Phase 6) ──────────────────────────────────────────────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA4_ID=
