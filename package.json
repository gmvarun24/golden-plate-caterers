{
  "name": "golden-plate-caterers",
  "version": "0.1.0",
  "private": true,
  "description": "Golden Plate Caterers — premium event-catering showcase & enquiry platform (Bangalore)",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "test:watch": "vitest",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:colors": "tsx scripts/check-no-raw-colors.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:contrast && npm run check:colors",
    "generate:logo": "tsx scripts/generate-logo.ts",
    "generate:rupee": "tsx scripts/generate-rupee-fonts.ts",
    "generate:pwa-icons": "tsx scripts/generate-pwa-icons.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "seed": "tsx --env-file=.env scripts/seed/index.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "motion": "12.43.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "nodemailer": "10.1.0",
    "payload": "3.90.2",
    "radix-ui": "1.7.0",
    "react": "19.2.6",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.6",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/opentype.js": "1.3.10",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "dotenv": "16.4.7",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "28.0.0",
    "opentype.js": "1.3.5",
    "pg": "8.20.0",
    "postcss": "8.5.29",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.18.1",
    "npm": ">=10"
  }
}
